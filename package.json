{
    "name": "sporteam-backend",
    "version": "2.0.0",
    "description": "Sporteam API - Red social de fútbol para equipos amateur",
    "main": "dist/server.js",
    "scripts": {
        "build": "tsc",
        "start": "node dist/server.js",
        "dev": "ts-node src/server.ts",
        "dev:watch": "ts-node-dev --respawn src/server.ts",
        "test": "jest --runInBand",
        "test:coverage": "jest --runInBand --coverage",
        "test:watch": "jest --runInBand --watch",
        "lint": "eslint src/",
        "lint:fix": "eslint src/ --fix",
        "format": "prettier --write src/"
    },
    "repository": {
        "type": "git",
        "url": "https://gitlab.iessanclemente.net/dawd/a20romandp.git"
    },
    "author": "Roman Dono Perez",
    "license": "MIT",
    "dependencies": {
        "bcrypt": "^5.0.0",
        "body-parser": "^1.19.0",
        "cloudinary": "^1.23.0",
        "colors": "^1.4.0",
        "cors": "^2.8.5",
        "dotenv": "^8.2.0",
        "express": "^4.17.1",
        "express-fileupload": "^1.2.0",
        "google-auth-library": "^6.1.3",
        "jsonwebtoken": "^8.5.1",
        "lodash": "^4.18.1",
        "mongoose": "^5.10.15",
        "mongoose-unique-validator": "^2.0.3",
        "underscore": "^1.11.0"
    },
    "devDependencies": {
        "@types/bcrypt": "^5.0.2",
        "@types/body-parser": "^1.19.5",
        "@types/cors": "^2.8.19",
        "@types/express": "^5.0.3",
        "@types/express-fileupload": "^1.5.1",
        "@types/jest": "^30.0.0",
        "@types/jsonwebtoken": "^9.0.9",
        "@types/mongoose": "^5.11.97",
        "@types/node": "^22.15.3",
        "@types/supertest": "^7.2.0",
        "@types/underscore": "^1.13.0",
        "jest": "^30.4.2",
        "mongodb-memory-server": "^11.1.0",
        "nodemon": "^2.0.7",
        "supertest": "^7.2.2",
        "ts-jest": "^29.4.9",
        "ts-node": "^10.9.2",
        "ts-node-dev": "^2.0.0",
        "typescript": "^6.0.3"
    }
}
