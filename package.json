{
    "name": "sporteam-backend",
    "version": "2.0.0",
    "description": "Sporteam API - Red social de fútbol para equipos amateur",
    "main": "dist/server.js",
    "scripts": {
        "build": "tsc && npm run generate:api-docs",
        "start": "node dist/server.js",
        "dev": "ts-node src/server.ts",
        "dev:watch": "ts-node-dev --respawn src/server.ts",
        "prisma:seed": "ts-node src/seed.ts",
        "generate:api-docs": "node scripts/generate-openapi.js",
        "generate:api-types": "echo 'Usar: npx openapi-typescript public/openapi.json -o src/generated/api-types.ts'",
        "test": "jest --runInBand",
        "test:coverage": "jest --runInBand --coverage",
        "test:watch": "jest --runInBand --watch",
        "lint": "eslint src/",
        "lint:fix": "eslint src/ --fix",
        "format": "prettier --write src/"
    },
    "prisma": {
        "seed": "ts-node src/seed.ts"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/romandono/sporteam.git"
    },
    "author": "Roman Dono Perez",
    "license": "MIT",
    "dependencies": {
        "@neondatabase/serverless": "^1.1.0",
        "@prisma/adapter-neon": "^7.8.0",
        "@prisma/adapter-pg": "^7.8.0",
        "@prisma/client": "^7.8.0",
        "@types/pg": "^8.20.0",
        "bcrypt": "^5.0.0",
        "body-parser": "^1.19.0",
        "@aws-sdk/client-s3": "^3.600.0",
        "colors": "^1.4.0",
        "cors": "^2.8.5",
        "dotenv": "^8.2.0",
        "express": "^4.17.1",
        "express-fileupload": "^1.2.0",
        "express-rate-limit": "^8.5.2",
        "express-validator": "^7.3.2",
        "google-auth-library": "^6.1.3",
        "helmet": "^8.1.0",
        "jsonwebtoken": "^8.5.1",
        "lodash": "^4.18.1",
        "pg": "^8.22.0",
        "pino": "^10.3.1",
        "pino-pretty": "^13.1.3",
        "swagger-jsdoc": "^6.2.8",
        "swagger-ui-express": "^5.0.1",
        "underscore": "^1.11.0"
    },
    "devDependencies": {
        "@types/bcrypt": "^5.0.2",
        "@types/body-parser": "^1.19.5",
        "@types/cors": "^2.8.19",
        "@types/express": "^5.0.3",
        "@types/express-fileupload": "^1.5.1",
        "@types/express-rate-limit": "^5.1.3",
        "@types/jest": "^30.0.0",
        "@types/jsonwebtoken": "^9.0.9",
        "@types/node": "^22.15.3",
        "@types/supertest": "^7.2.0",
        "@types/swagger-jsdoc": "^6.0.4",
        "@types/swagger-ui-express": "^4.1.8",
        "@types/underscore": "^1.13.0",
        "jest": "^30.4.2",
        "nodemon": "^2.0.7",
        "prisma": "^7.8.0",
        "supertest": "^7.2.2",
        "ts-jest": "^29.4.9",
        "ts-node": "^10.9.2",
        "ts-node-dev": "^2.0.0",
        "typescript": "^6.0.3"
    }
}
