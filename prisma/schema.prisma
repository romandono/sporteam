generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN_ROLE
  USER_ROLE
  JUGADOR_ROLE
  ENTRENADOR_ROLE
  CLUB_ROLE
}

enum ProfileType {
  JUGADOR
  ENTRENADOR
  PREPARADOR
  MEDICO
  DIRECTIVO
  OJEADOR
}

model User {
  id              String   @id @default(uuid())
  role            Role
  nombre          String
  apellidos       String
  email           String   @unique
  password        String
  estado          Boolean  @default(true)
  image           String?
  google          Boolean  @default(false)
  estadoDeportivo String?  @map("estado_deportivo")
  clubId          String?  @map("club_id")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  club         Club?         @relation(fields: [clubId], references: [id])
  perfiles     Profile[]
  zonas        UserZona[]

  @@map("users")
}

model Profile {
  id               String       @id @default(uuid())
  userId           String       @map("user_id")
  profileType      ProfileType  @map("profile_type")
  nombreDeportivo  String?      @map("nombre_deportivo")
  telefono         String?
  fechaNacimiento  DateTime?    @map("fecha_nacimiento")
  lateralidad      String?
  demarcacion      String[]
  altura           Decimal?     @db.Decimal(5, 2)
  peso             Decimal?     @db.Decimal(5, 2)
  entrenadorPorteros Boolean    @default(false) @map("entrenador_porteros")
  titulacion       String[]
  localidadId      String?      @map("localidad_id")
  metadata         Json?
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")

  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  localidad    Localidad?     @relation(fields: [localidadId], references: [id])
  estadisticas Estadistica[]

  @@map("perfiles")
}

model Club {
  id          String   @id @default(uuid())
  nombre      String
  localidad   String?
  provinciaId String?  @map("provincia_id")
  modalidad   String?
  image       String?
  zonaId      String?  @map("zona_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  provincia Provincia? @relation(fields: [provinciaId], references: [id])
  zona      Zona?      @relation(fields: [zonaId], references: [id])
  usuarios  User[]

  @@map("clubs")
}

model Estadistica {
  id                String @id @default(uuid())
  profileId         String @map("profile_id")
  temporadaId       String @map("temporada_id")
  partidosJugados   Int    @default(0) @map("partidos_jugados")
  goles             Int    @default(0)
  asistencias       Int    @default(0)
  tarjetasAmarillas Int    @default(0) @map("tarjetas_amarillas")
  tarjetasRojas     Int    @default(0) @map("tarjetas_rojas")

  profile   Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  temporada Temporada @relation(fields: [temporadaId], references: [id])

  @@unique([profileId, temporadaId])
  @@map("estadisticas")
}

model Temporada {
  id   String @id @default(uuid())
  anho String @unique

  estadisticas Estadistica[]

  @@map("temporadas")
}

model Provincia {
  id     String @id @default(uuid())
  nombre String @unique

  clubs Club[]

  @@map("provincias")
}

model Zona {
  id         String @id @default(uuid())
  nombreZona String @unique @map("nombre_zona")

  clubs    Club[]
  usuarios UserZona[]

  @@map("zonas")
}

model Localidad {
  id       String    @id @default(uuid())
  nombre   String

  perfiles Profile[]

  @@map("localidades")
}

model UserZona {
  userId String @map("user_id")
  zonaId String @map("zona_id")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  zona Zona @relation(fields: [zonaId], references: [id], onDelete: Cascade)

  @@id([userId, zonaId])
  @@map("user_zonas")
}
