# Puerto del servidor
PORT=3000

# PostgreSQL (Neon) connection string
# Local: postgresql://localhost:5432/sporteam
# Docker: postgresql://sporteam:sporteam_pass@postgres:5432/sporteam
# Neon: postgresql://<user>:<pass>@<endpoint>.us-east-1.aws.neon.tech/sporteam?sslmode=require
DATABASE_URL=postgresql://localhost:5432/sporteam

# JWT secret key (generar una segura con: openssl rand -hex 64)
JWT_SECRET=poner_un_secreto_seguro_aqui

# Google OAuth Client ID (opcional, para login con Google)
CLIENT_ID=

# Cloudflare R2 (almacenamiento de imágenes)
R2_ENDPOINT=https://<account>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=sporteam-bucket
R2_PUBLIC_URL=

# Nivel de logging: info, debug, warn, error
LOG_LEVEL=info
